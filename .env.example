# ===== 必須 =====
# ダッシュボードのパスワード（長いランダム文字列にする。例: openssl rand -hex 24 の結果）
ACCESS_TOKEN=ここを変更
# Web Pushの連絡先（自分のメールアドレス）
VAPID_SUBJECT=mailto:you@example.com

# ===== 基本はこのまま =====
PORT=8787
HOST=127.0.0.1
# 新規pump.funトークンの売買を発行直後から追跡（スナイパー・初期勢の検出に必要）
TRACK_NEW_TOKENS=1
MAX_TOKEN_SUBS=600

# ===== 任意（使うときだけ） =====
# Telegramにも通知したい場合
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# KOLリーダーボードの自動取り込み（Solana Tracker Data API）
SOLANATRACKER_API_KEY=
# Solana RPC（自前バブルマップ用）。空なら無料の公開RPC。HeliusのAPIキー(無料枠あり)を入れると速く安定
HELIUS_API_KEY=
RPC_URL=
OWN_CLUSTER=1
# Bubblemapsのクラスタ判定（APIキーがある場合）
BUBBLEMAPS_API_KEY=
BUBBLEMAPS_KEY_HEADER=x-api-key
